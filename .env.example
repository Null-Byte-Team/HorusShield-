# ══════════════════════════════════════════════════════════════════
# HorusShield 2.0 — Environment Configuration
# Team NullByte · WE School · Alexandria 🇪🇬
# ══════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values. Never commit `.env`
# itself — only this example file is version controlled.
#
# Every variable below is read directly by backend/config.py (or the
# module noted in its comment). None of these have any effect unless
# actually set — every default below matches the application's
# built-in default, so an empty/missing .env behaves exactly like the
# existing desktop app always has.

# ── Environment / Mode ──────────────────────────────────────────────
# "development" or "production". Controls CORS origins and debug flag.
HORUS_ENV=development

# Set to "true" only inside the Docker image — skips the native
# pywebview desktop window and runs the Flask/Socket.IO server in the
# foreground instead. Leave unset for the normal desktop app / EXE.
HORUS_HEADLESS=false

# ── Flask Server ─────────────────────────────────────────────────────
# Secret key for session signing. If unset, one is generated on first
# run and persisted to backend/.horus_secret — set this explicitly for
# reproducible deployments (e.g. Docker with a fresh container each run).
HORUS_SECRET_KEY=

# Bind address. Default is 127.0.0.1 (local-only, matches existing
# desktop-app behavior). docker-compose.yml sets this to 0.0.0.0 so the
# container's exposed port is reachable — do not change this for the
# desktop app.
HORUS_HOST=127.0.0.1
HORUS_PORT=5050

# "true"/"false" — Flask debug mode. Keep false in production.
HORUS_DEBUG=false

# ── Database ─────────────────────────────────────────────────────────
# Full path to the SQLite database file. If unset, defaults to
# backend/database/horus.db. Set this to point at a mounted volume
# path in Docker (see docker-compose.yml).
HORUS_DB_PATH=

# ── Logging ──────────────────────────────────────────────────────────
HORUS_LOG_LEVEL=INFO
HORUS_LOG_FILE=

# ── Request Limits & Rate Limiting (added in the security/audit pass) ──
# Max request body size in bytes. Default 5 MB — see config.py for why.
HORUS_MAX_CONTENT_LENGTH=5242880
# Set to "false" to disable rate limiting entirely (e.g. for load testing
# in a controlled environment). Never disable this in a real deployment.
HORUS_RATELIMIT_ENABLED=true
# flask-limiter storage backend. Default is in-memory (fine for a single
# process; resets on restart, doesn't share state across processes). Set
# to a Redis URI (e.g. redis://localhost:6379) for multi-process deployments.
HORUS_RATELIMIT_STORAGE=memory://

# ── Network Monitoring (engine/network_monitor.py) ─────────────────
# Network interface name to monitor. Leave unset to auto-detect.
HORUS_INTERFACE=

# ── V-8 Scanner — OWASP ZAP (vscanner/zap_client.py) ────────────────
# ZAP must be running separately in daemon mode, e.g.:
#   zap.sh -daemon -port 8090 -config api.key=<key>
HORUS_ZAP_URL=http://127.0.0.1:8090
HORUS_ZAP_KEY=

# ── V-8 Scanner — Nikto / Nmap (vscanner/*.py) ──────────────────────
# Only needed if the binaries aren't already on PATH.
HORUS_NIKTO_PATH=nikto
HORUS_NMAP_PATH=nmap

# ── Auth — Email verification SMTP (auth/auth_manager.py) ──────────
HORUS_SMTP_HOST=
HORUS_SMTP_PORT=587
HORUS_SMTP_USER=
HORUS_SMTP_PASS=

# ── Auth — Google Sign-In (auth/auth_manager.py) ────────────────────
HORUS_GOOGLE_CLIENT_ID=

# ── Ask Horus AI chatbot — Claude API (ai/conversation_engine.py) ──
# Optional. Without this set, Horus AI silently falls back to its
# built-in rule-based responder — the chatbot still works, just without
# the Claude-backed conversational layer.
ANTHROPIC_API_KEY=
